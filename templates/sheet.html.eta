<!--
  One template, parameterised. The two source designs
  (resume-smart-contract.html, resume-full-stack.html) were diffed and found
  to differ in exactly five places in the print CSS — accent colour, chip
  colour, @page margin, .edu div font-size, and an optional trailing
  section:last-child h2 rule. Those are the only five things this template
  parameterises; everything else in the <style> block below is copied
  verbatim from the source designs. See src/variants.ts for the presets and
  AGENTS.md rule 3 for why this CSS must not be "improved" here.

  Do not restyle. If a rule looks wrong, fix it in the source design first,
  re-diff, then port the change here verbatim.
-->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: <%= it.pageMargin %>; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink: #14181f; --body: #333a45; --muted: #6b7482;
    --accent: <%= it.accent %>; --rule: #d8dde3; --chip: <%= it.chip %>;
  }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    font-family: "Carlito", "Calibri", "DejaVu Sans", sans-serif;
    font-size: 9.05pt; line-height: 1.27; color: var(--body); background: #fff;
  }
  .sheet { width: 186mm; margin: 0 auto; }

  header { border-bottom: 2.2pt solid var(--accent); padding-bottom: 4.5pt; margin-bottom: 6pt; }
  h1 { font-size: 20pt; font-weight: 700; letter-spacing: .6pt; color: var(--ink); line-height: 1.05; text-transform: uppercase; }
  .role { font-size: 9.8pt; font-weight: 700; color: var(--accent); letter-spacing: .25pt; margin-top: 1.5pt; }
  .contact { margin-top: 3.5pt; font-size: 8.2pt; color: var(--muted); line-height: 1.35; }
  .contact span { white-space: nowrap; }
  .contact .sep { color: var(--rule); padding: 0 3.5pt; }

  section { margin-bottom: 4.2pt; }
  section:last-child { margin-bottom: 0; }
  h2 {
    font-size: 8.5pt; font-weight: 700; text-transform: uppercase; letter-spacing: 1.1pt;
    color: var(--accent); border-bottom: .7pt solid var(--rule);
    padding-bottom: 1.6pt; margin-bottom: 3.2pt;
  }
  .summary { font-size: 9.05pt; line-height: 1.33; text-align: justify; }

  .skills { display: grid; grid-template-columns: 24mm 1fr; gap: 2.2pt 6pt; }
  .skills dt { font-weight: 700; color: var(--ink); font-size: 8.45pt; }
  .skills dd { font-size: 8.55pt; }

  .job { margin-bottom: 4pt; }
  .job:last-child { margin-bottom: 0; }
  .job-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8pt; }
  .job-title { font-size: 9.5pt; font-weight: 700; color: var(--ink); }
  .job-title .org { font-weight: 400; color: var(--accent); }
  .job-meta { font-size: 8pt; color: var(--muted); white-space: nowrap; }
  ul { list-style: none; margin-top: 2pt; }
  li { position: relative; padding-left: 8.5pt; margin-bottom: 1.35pt; }
  li::before { content: ""; position: absolute; left: 1.2pt; top: 4pt; width: 2.5pt; height: 2.5pt; border-radius: 50%; background: var(--accent); }
  li b { color: var(--ink); font-weight: 700; }

  .os li::before { background: var(--muted); }
  .os code { font-family: "DejaVu Sans Mono", monospace; font-size: 7.6pt; background: var(--chip); padding: 0 2pt; border-radius: 2pt; color: var(--ink); }

  .edu div { font-size: <%= it.eduFontSize %>; }
<% if (it.lastChildHeadingRule) { -%>
  section:last-child h2 { margin-bottom: 2.4pt; }
<% } -%>
  .edu b { color: var(--ink); }
</style>
<title><%= it.identity.name %> — CV</title>
</head>
<body>
<div class="sheet">

  <header>
    <h1><%= it.identity.name %></h1>
    <div class="role"><%= it.headline %></div>
    <div class="contact">
      <% it.contactPrimary.forEach(function (item, i) { -%>
      <span><%= item %></span><% if (i < it.contactPrimary.length - 1) { %><span class="sep">|</span><% } %>
      <% }) -%>
      <% if (it.contactLinks.length) { -%>
      <br>
      <% it.contactLinks.forEach(function (item, i) { -%>
      <span><%= item %></span><% if (i < it.contactLinks.length - 1) { %><span class="sep">|</span><% } %>
      <% }) -%>
      <% } -%>
    </div>
  </header>

<% if (it.summary) { -%>
  <section>
    <h2>Profile</h2>
    <p class="summary"><%= it.summary %></p>
  </section>
<% } -%>

<% if (it.skills.length) { -%>
  <section>
    <h2>Technical Skills</h2>
    <dl class="skills">
      <% it.skills.forEach(function (group) { -%>
      <dt><%= group.label %></dt><dd><%= group.items.join(', ') %></dd>
      <% }) -%>
    </dl>
  </section>
<% } -%>

<% if (it.roles.length) { -%>
  <section>
    <h2>Experience</h2>
    <% it.roles.forEach(function (role) { -%>
    <div class="job">
      <div class="job-head">
        <div class="job-title"><%= role.title %> <span class="org">— <%= role.company %></span></div>
        <div class="job-meta"><%= role.dateRange %><% if (role.location) { %> · <%= role.location %><% } %></div>
      </div>
      <ul>
        <% role.bullets.forEach(function (bullet) { -%>
        <li><%= bullet.text %></li>
        <% }) -%>
      </ul>
    </div>
    <% }) -%>
  </section>
<% } -%>

<% if (it.projects.length) { -%>
  <section>
    <h2>Open Source</h2>
    <ul class="os">
      <% it.projects.forEach(function (project) { -%>
      <% project.bullets.forEach(function (bullet) { -%>
      <li><code><%= project.name %></code> <%= bullet.text %></li>
      <% }) -%>
      <% }) -%>
    </ul>
  </section>
<% } -%>

<% if (it.education.length) { -%>
  <section>
    <h2>Education</h2>
    <% it.education.forEach(function (edu) { -%>
    <div class="edu">
      <div><b><%= edu.qualification %></b> — <%= edu.institution %>, <%= edu.years %><% if (edu.detail) { %> · <%= edu.detail %><% } %></div>
    </div>
    <% }) -%>
  </section>
<% } -%>

</div>
</body>
</html>
